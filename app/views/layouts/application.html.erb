<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || t("application.title") %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("application.title") %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%# = tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "dictio_logo_plume_rounded.png" %>

    <link
      rel="apple-touch-icon"
      href="<%= asset_path('dictio_logo_plume_rounded.png') %>"
    >

    <%# Google Fonts for Nunito and Inter %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    >

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#F7F9FC]">
    <nav class="bg-white shadow-sm border-b border-[#E0E7EF]">
      <div class="container mx-auto px-5 py-4 flex justify-between items-center">
        <%= link_to root_path do %>
          <%= image_tag "dictio_logo_navbar.png", alt: t("application.title"), class: "h-16 w-auto" %>
        <% end %>

        <div class="flex gap-4 items-center">
          <div class="flex gap-2">
            <%= link_to locale_path(:fr), data: { turbo_method: :patch }, class: "text-2xl hover:opacity-70 #{'opacity-50' if I18n.locale == :en}" do %>
              🇫🇷
            <% end %>

            <%= link_to locale_path(:en), data: { turbo_method: :patch }, class: "text-2xl hover:opacity-70 #{'opacity-50' if I18n.locale == :fr}" do %>
              🇬🇧
            <% end %>
          </div>

          <% if current_user %>
            <span class="text-[#777777]"><%= current_user.email %></span>
            <%= button_to t("sessions.logout"), logout_path, method: :delete, class: "text-[#3A7BD5] hover:underline" %>
          <% else %>
            <%= link_to t("sessions.login"), new_session_path, class: "text-[#3A7BD5] hover:underline" %>
            <%= link_to t("users.signup"), new_user_path, class: "text-[#3A7BD5] hover:underline" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div
        class="
          bg-green-50 border border-green-200 text-green-700 px-4 py-3
          mx-auto container mt-4 rounded
        "
      >
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div
        class="
          bg-red-50 border border-red-200 text-red-700 px-4 py-3 mx-auto
          container mt-4 rounded
        "
      >
        <%= alert %>
      </div>
    <% end %>

    <main class="container mx-auto mt-8 px-5"><%= yield %></main>
  </body>
</html>
