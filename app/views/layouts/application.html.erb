<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || t("application.title") %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("application.title") %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%# = tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "dictio_logo_plume_rounded.png" %>

    <link
      rel="apple-touch-icon"
      href="<%= asset_path('dictio_logo_plume_rounded.png') %>"
    >

    <%# Google Fonts for Nunito and Inter %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    >

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#F7F9FC]">
    <nav class="bg-white shadow-sm border-b border-[#E0E7EF]">
      <div class="container mx-auto px-5 py-4 flex justify-between items-center">
        <%= link_to root_path do %>
          <%= image_tag "dictio_logo_navbar.png", alt: t("application.title"), class: "h-16 w-auto" %>
        <% end %>

        <div class="flex gap-4 items-center">
          <div data-controller="locale-selector" class="relative">
            <button
              type="button"
              data-action="click->locale-selector#toggle"
              class="text-2xl cursor-pointer hover:opacity-80 transition-opacity"
            >
              <%= locale_flag(I18n.locale) %>
            </button>

            <div
              data-locale-selector-target="menu"
              class="
                hidden absolute right-0 mt-2 bg-white border
                border-[#E0E7EF] rounded-md shadow-sm py-1 z-10
              "
            >
              <% I18n.available_locales.each do |locale| %>
                <% unless locale == I18n.locale %>
                  <button
                    type="button"
                    data-action="click->locale-selector#change"
                    data-locale-selector-locale-param="<%= locale %>"
                    class="block w-full text-left px-4 py-2 text-2xl hover:bg-[#F7F9FC]"
                  >
                    <%= locale_flag(locale) %>
                  </button>
                <% end %>
              <% end %>
            </div>
          </div>

          <% if current_user %>
            <div data-controller="user-menu" class="relative">
              <button
                type="button"
                data-action="click->user-menu#toggle"
                class="
                  text-[#3A7BD5] hover:text-[#2d6bb8] cursor-pointer p-1.5
                  rounded-md hover:bg-[#F7F9FC] transition-colors
                  inline-flex items-center justify-center
                "
                style="width: 36px; height: 36px;"
              >
                <svg
                  width="24"
                  height="24"
                  fill="none"
                  stroke="#3A7BD5"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  />
                </svg>
              </button>

              <div
                data-user-menu-target="menu"
                class="
                  hidden absolute right-0 mt-2 w-48 bg-white border
                  border-[#E0E7EF] rounded-md shadow-sm py-1 z-10
                "
              >
                <%= link_to t("users.edit_profile"), edit_user_path, class: "block px-4 py-2 text-sm text-[#333333] hover:bg-[#F7F9FC]" %>
                <%= button_to t("sessions.logout"), logout_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-[#333333] hover:bg-[#F7F9FC]" %>
              </div>
            </div>
          <% else %>
            <%= link_to t("sessions.login"), new_session_path, class: "text-[#3A7BD5] hover:underline" %>
            <%= link_to t("users.signup"), new_user_path, class: "text-[#3A7BD5] hover:underline" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div
        class="
          bg-green-50 border border-green-200 text-green-700 px-4 py-3
          mx-auto container mt-4 rounded
        "
      >
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div
        class="
          bg-red-50 border border-red-200 text-red-700 px-4 py-3 mx-auto
          container mt-4 rounded
        "
      >
        <%= alert %>
      </div>
    <% end %>

    <main class="container mx-auto mt-8 px-5"><%= yield %></main>
  </body>
</html>
