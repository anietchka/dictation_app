<div class="w-full max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= t("dictations.new.title") %></h1>

  <%= form_with model: @dictation, url: dictations_path, local: true, class: "space-y-4" do |form| %>
    <% if @dictation.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
        <ul class="list-disc list-inside">
          <% @dictation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :level, t("dictations.new.level"), class: "block text-sm font-medium mb-1" %>
      <%= form.select :level, options_for_select(dictation_levels.map { |level| [t("dictations.levels.#{level}", default: level), level] }, @dictation.level), { prompt: t("dictations.new.select_level") }, { class: "w-full px-3 py-2 border border-gray-300 rounded-md" } %>
    </div>

    <div>
      <%= form.label :min_words, t("dictations.new.min_words"), class: "block text-sm font-medium mb-1" %>
      <%= form.number_field :min_words, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :max_words, t("dictations.new.max_words"), class: "block text-sm font-medium mb-1" %>
      <%= form.number_field :max_words, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :min_sentences, t("dictations.new.min_sentences"), class: "block text-sm font-medium mb-1" %>
      <%= form.number_field :min_sentences, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :max_sentences, t("dictations.new.max_sentences"), class: "block text-sm font-medium mb-1" %>
      <%= form.number_field :max_sentences, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :requested_words, t("dictations.new.requested_words"), class: "block text-sm font-medium mb-1" %>
      <%= form.text_area :requested_words, rows: 3, placeholder: "ex: maison, école, jardin", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :requested_rules, t("dictations.new.requested_rules"), class: "block text-sm font-medium mb-1" %>
      <%= form.text_area :requested_rules, rows: 3, placeholder: "ex: accord du participe passé, pluriel des noms", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div class="flex gap-4">
      <%= form.submit t("dictations.new.create"), class: "bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700" %>
      <%= link_to t("dictations.new.cancel"), dictations_path, class: "bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300" %>
    </div>
  <% end %>
</div>

