<div class="w-full max-w-3xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold mb-4"><%= t("dictations.show.title") %></h1>
    <%= link_to t("dictations.show.back"), dictations_path, class: "text-blue-600 hover:underline" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-6 space-y-4">
    <div>
      <span class="font-medium"><%= t("dictations.show.level") %>:</span>
      <span class="ml-2"><%= @dictation.level || "-" %></span>
    </div>

    <div>
      <span class="font-medium"><%= t("dictations.show.min_words") %>:</span>
      <span class="ml-2"><%= @dictation.min_words || "-" %></span>
    </div>

    <div>
      <span class="font-medium"><%= t("dictations.show.max_words") %>:</span>
      <span class="ml-2"><%= @dictation.max_words || "-" %></span>
    </div>

    <div>
      <span class="font-medium"><%= t("dictations.show.min_sentences") %>:</span>
      <span class="ml-2"><%= @dictation.min_sentences || "-" %></span>
    </div>

    <div>
      <span class="font-medium"><%= t("dictations.show.max_sentences") %>:</span>
      <span class="ml-2"><%= @dictation.max_sentences || "-" %></span>
    </div>

    <% if @dictation.requested_words.present? %>
      <div>
        <span class="font-medium"><%= t("dictations.show.requested_words") %>:</span>
        <p class="mt-1 text-gray-700"><%= @dictation.requested_words %></p>
      </div>
    <% end %>

    <% if @dictation.requested_rules.present? %>
      <div>
        <span class="font-medium"><%= t("dictations.show.requested_rules") %>:</span>
        <p class="mt-1 text-gray-700"><%= @dictation.requested_rules %></p>
      </div>
    <% end %>

    <% if @dictation.content.present? %>
      <div class="border-t pt-4">
        <h2 class="font-medium mb-2"><%= t("dictations.show.content") %>:</h2>
        <div class="bg-gray-50 p-4 rounded border border-gray-200">
          <p class="whitespace-pre-wrap"><%= @dictation.content %></p>
        </div>
      </div>
    <% else %>
      <div class="border-t pt-4">
        <p class="text-gray-500 italic"><%= t("dictations.show.content") %>: <%= t("dictations.show.content_not_generated") %></p>
      </div>
    <% end %>

    <div class="border-t pt-4 text-sm text-gray-500">
      <p><%= t("dictations.show.created_at") %>: <%= @dictation.created_at.strftime("%d/%m/%Y %H:%M") %></p>
      <p><%= t("dictations.show.updated_at") %>: <%= @dictation.updated_at.strftime("%d/%m/%Y %H:%M") %></p>
    </div>
  </div>
</div>

