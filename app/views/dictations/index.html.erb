<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold"><%= t("dictations.index.title") %></h1>
    <%= link_to t("dictations.index.new_dictation"), new_dictation_path, class: "bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700" %>
  </div>

  <% if @dictations.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white border border-gray-200 rounded-lg">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("dictations.index.level") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("dictations.index.min_words") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("dictations.index.max_words") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("dictations.index.created_at") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("dictations.index.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @dictations.each do |dictation| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm"><%= dictation.level || "-" %></td>
              <td class="px-4 py-3 text-sm"><%= dictation.min_words || "-" %></td>
              <td class="px-4 py-3 text-sm"><%= dictation.max_words || "-" %></td>
              <td class="px-4 py-3 text-sm"><%= dictation.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="px-4 py-3 text-sm">
                <%= link_to t("dictations.index.view"), dictation_path(dictation), class: "text-blue-600 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-gray-50 rounded-lg">
      <p class="text-gray-500"><%= t("dictations.index.no_dictations") %></p>
    </div>
  <% end %>
</div>

