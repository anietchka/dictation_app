<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold"><%= t("dictations.index.title") %></h1>
    <%= link_to t("dictations.index.new_dictation"), new_dictation_path, class: "bg-[#3A7BD5] text-white py-2 px-4 rounded-md hover:bg-[#2d6bb8] transition-colors" %>
  </div>

  <% if @dictations.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white border border-[#E0E7EF] rounded-md shadow-sm">
        <thead class="bg-white">
          <tr>
            <th
              class="
                px-4 py-3 text-left text-xs font-medium text-[#777777]
                uppercase
              "
            >
              <%= sortable_column("name", t("dictations.index.name"), @sort_by, @direction) %>
            </th>

            <th
              class="
                px-4 py-3 text-left text-xs font-medium text-[#777777]
                uppercase
              "
            >
              <%= sortable_column("level", t("dictations.index.level"), @sort_by, @direction) %>
            </th>

            <th
              class="
                px-4 py-3 text-left text-xs font-medium text-[#777777]
                uppercase
              "
            >
              <%= sortable_column("created_at", t("dictations.index.created_at"), @sort_by, @direction) %>
            </th>
          </tr>
        </thead>

        <tbody class="divide-y divide-[#E0E7EF]">
          <% @dictations.each do |dictation| %>
            <tr
              data-controller="clickable-row"
              data-clickable-row-url-value="<%= dictation_path(dictation) %>"
              data-action="click->clickable-row#click"
              class="hover:bg-[#F7F9FC]"
            >
              <td class="px-4 py-3 text-sm text-[#333333] font-medium">
                <%= dictation.name %>
              </td>

              <td class="px-4 py-3 text-sm text-[#333333]">
                <%= dictation.level || "-" %>
              </td>

              <td class="px-4 py-3 text-sm text-[#333333]">
                <%= dictation.created_at.strftime("%d/%m/%Y %H:%M") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div
      class="
        text-center py-12 bg-white rounded-md border border-[#E0E7EF]
        shadow-sm
      "
    >
      <p class="text-[#777777]"><%= t("dictations.index.no_dictations") %></p>
    </div>
  <% end %>
</div>
