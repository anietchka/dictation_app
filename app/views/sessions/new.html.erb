<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= t("sessions.login") %></h1>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: sessions_path, local: true, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email, t("sessions.email"), class: "block text-sm font-medium mb-1" %>
      <%= form.email_field :email, required: true, autofocus: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :password, t("sessions.password"), class: "block text-sm font-medium mb-1" %>
      <%= form.password_field :password, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.submit t("sessions.login"), class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700" %>
    </div>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= t("sessions.no_account") %> <%= link_to t("sessions.signup_link"), new_user_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
