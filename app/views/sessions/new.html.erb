<div class="w-full max-w-md mx-auto">
  <div class="bg-white border border-[#E0E7EF] rounded-md shadow-sm p-8">
    <h1 class="text-2xl font-bold mb-6 text-[#3A7BD5]"><%= t("sessions.login") %></h1>

    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mb-4">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: sessions_path, local: true, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email, t("sessions.email"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.email_field :email, required: true, autofocus: true, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
      </div>

      <div>
        <%= form.label :password, t("sessions.password"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.password_field :password, required: true, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
      </div>

      <div>
        <%= form.submit t("sessions.login"), class: "w-full bg-[#3A7BD5] text-white py-2 px-4 rounded-md hover:bg-[#2d6bb8] transition-colors" %>
      </div>
    <% end %>

    <p class="mt-4 text-center text-sm text-[#777777]">
      <%= t("sessions.no_account") %> <%= link_to t("sessions.signup_link"), new_user_path, class: "text-[#3A7BD5] hover:underline" %>
    </p>
  </div>
</div>
