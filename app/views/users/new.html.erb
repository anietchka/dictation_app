<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6"><%= t("users.signup") %></h1>

  <%= form_with model: @user, url: users_path, local: true, class: "space-y-4" do |form| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :email, t("users.email"), class: "block text-sm font-medium mb-1" %>
      <%= form.email_field :email, required: true, autofocus: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.label :password, t("users.password"), class: "block text-sm font-medium mb-1" %>
      <%= form.password_field :password, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
      <p class="text-xs text-gray-500 mt-1"><%= t("users.password_minimum") %></p>
    </div>

    <div>
      <%= form.label :password_confirmation, t("users.password_confirmation"), class: "block text-sm font-medium mb-1" %>
      <%= form.password_field :password_confirmation, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
    </div>

    <div>
      <%= form.submit t("users.signup"), class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700" %>
    </div>
  <% end %>

  <p class="mt-4 text-center text-sm">
    <%= t("users.already_have_account") %> <%= link_to t("users.login_link"), new_session_path, class: "text-blue-600 hover:underline" %>
  </p>
</div>
