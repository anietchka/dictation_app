<div class="w-full max-w-md mx-auto">
  <div class="bg-white border border-[#E0E7EF] rounded-md shadow-sm p-8">
    <h1 class="text-2xl font-bold mb-6 text-[#3A7BD5]"><%= t("users.signup") %></h1>

    <%= form_with model: @user, url: users_path, local: true, class: "space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mb-4">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :email, t("users.email"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.email_field :email, required: true, autofocus: true, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
      </div>

      <div>
        <%= form.label :password, t("users.password"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.password_field :password, required: true, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
        <p class="text-xs text-[#777777] mt-1"><%= t("users.password_minimum") %></p>
      </div>

      <div>
        <%= form.label :password_confirmation, t("users.password_confirmation"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.password_field :password_confirmation, required: true, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
      </div>

      <div>
        <%= form.submit t("users.signup"), class: "w-full bg-[#3A7BD5] text-white py-2 px-4 rounded-md hover:bg-[#2d6bb8] transition-colors" %>
      </div>
    <% end %>

    <p class="mt-4 text-center text-sm text-[#777777]">
      <%= t("users.already_have_account") %> <%= link_to t("users.login_link"), new_session_path, class: "text-[#3A7BD5] hover:underline" %>
    </p>
  </div>
</div>
