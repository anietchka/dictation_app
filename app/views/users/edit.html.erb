<div class="w-full max-w-md mx-auto">
  <div class="bg-white border border-[#E0E7EF] rounded-md shadow-sm p-8">
    <h1 class="text-2xl font-bold mb-6 text-[#3A7BD5]"><%= t("users.edit.title") %></h1>

    <%= form_with model: @user, url: user_path, method: :patch, local: true, class: "space-y-4" do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mb-4">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :email, t("users.email"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.email_field :email, required: true, autofocus: true, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
      </div>

      <div>
        <%= form.label :password, t("users.password"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.password_field :password, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
        <p class="text-xs text-[#777777] mt-1"><%= t("users.password_minimum") %> (<%= t("users.edit.password_optional") %>)</p>
      </div>

      <div>
        <%= form.label :password_confirmation, t("users.password_confirmation"), class: "block text-sm font-medium mb-1 text-[#333333]" %>
        <%= form.password_field :password_confirmation, class: "w-full px-3 py-2 border border-[#D5DCE5] rounded-md focus:ring-2 focus:ring-[#3A7BD5] focus:border-[#3A7BD5] text-[#333333]" %>
      </div>

      <div class="flex gap-4">
        <%= form.submit t("users.edit.update"), class: "flex-1 bg-[#3A7BD5] text-white py-2 px-4 rounded-md hover:bg-[#2d6bb8] transition-colors" %>
        <%= link_to t("users.edit.cancel"), dictations_path, class: "flex-1 bg-white text-[#3A7BD5] border border-[#3A7BD5] py-2 px-4 rounded-md hover:bg-[#A9D1FF] transition-colors text-center" %>
      </div>
    <% end %>
  </div>
</div>

